<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>studio.orbitlabs.intent.screentime</string>
	<!-- install under ~/Library/LaunchAgents and point ProgramArguments at
	     ~/.mac-automations/intent-screentime/run_collect.zsh (outside Documents).
	     Documents paths get Operation not permitted under launchd TCC. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>REPLACE_WITH_HOME/.mac-automations/intent-screentime/run_collect.zsh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>REPLACE_WITH_HOME/Library/Logs/IntentScreenTime/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_WITH_HOME/Library/Logs/IntentScreenTime/launchd.err.log</string>
</dict>
</plist>
